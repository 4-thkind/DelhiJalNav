# Backend (Lambda environment, or the shell running backend/local_server.py).
# Never put any of these in VITE_* variables or frontend code.
APP_MODE=local-demo                 # local-demo | aws-demo | live-pilot
DEMO_ADMIN_KEY=change-me-16+chars   # demo reviewer actions and /v1/demo/control
PSEUDONYM_SALT=change-me-16+chars   # HMAC salt for contributor pseudonyms (required outside local-demo)
EVIDENCE_FRESHNESS_MINUTES=30       # policy, not hydrology
HAZARD_POLL_SECONDS=15              # client poll interval it is told to use
ROUTE_PROVIDER=reviewed-fixtures
RETENTION_DAYS=7                    # DynamoDB TTL for observations and idempotency rows
# TABLE_NAME=...                    # set only in AWS; unset means the in-process store
GOOGLE_MAPS_API_KEY=                # optional: Google Routes API (traffic-aware, two-wheeler); empty = public OSRM

# Frontend (public, baked in at build time). Empty means same origin, which is
# right for CloudFront (it routes /v1/* to the API) and for local_server.py.
VITE_API_BASE=
VITE_GOOGLE_MAPS_KEY=               # optional: Maps JavaScript API key (put it in app/.env.local); empty = OpenStreetMap
